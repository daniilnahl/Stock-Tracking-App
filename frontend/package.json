{
  "name": "stock-tracker-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.19.0 <25", "npm": ">=10.8.2 <12" },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "generate": "node scripts/generate-contracts.mjs",
    "schema:check": "node scripts/generate-contracts.mjs --check",
    "typecheck": "tsc --noEmit",
    "build": "npm run schema:check && npm run typecheck && vite build",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": { "react": "19.3.1", "react-dom": "19.3.1" },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
